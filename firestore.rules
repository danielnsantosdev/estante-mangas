rules_version = '2';
// Regras de segurança da Estante de Mangás (v3).
// Elas rodam no servidor do Google: nem o app nem ninguém consegue passar por cima delas.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quem é quem ----------
    // Você, o administrador.
    function admin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'danielnsantos99@gmail.com';
    }
    // Está na lista de convidados?
    function convidado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/convidados/$(request.auth.token.email.lower()));
    }
    // Pode usar o app (convidado ou administrador).
    function acesso() { return convidado() || admin(); }
    // É o dono destes dados?
    function dono(uid) { return request.auth != null && request.auth.uid == uid; }
    // O perfil desta pessoa está público e não foi ocultado (acesso removido)?
    function publico(uid) {
      return exists(/databases/$(database)/documents/perfis/$(uid))
        && get(/databases/$(database)/documents/perfis/$(uid)).data.publico == true
        && get(/databases/$(database)/documents/perfis/$(uid)).data.get('oculto', false) == false;
    }

    // ---------- validações ----------
    function nomesOk(d) {
      return texto(d, 'nomeEN', 200) && texto(d, 'nomePT', 200) && texto(d, 'idade', 6)
        && (!('nomes' in d) || (d.nomes is list && d.nomes.size() <= 30));
    }
    function notaOk(n) { return n is number && n >= 1 && n <= 10 && math.floor(n * 2) == n * 2; }
    function texto(d, campo, max) { return !(campo in d) || (d[campo] is string && d[campo].size() <= max); }
    function camposManga(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.chapter is number && d.chapter >= 0 && d.chapter < 100000
        && d.status in ['lendo', 'fila', 'acumulando', 'pausado', 'concluido']
        && texto(d, 'link', 2000) && texto(d, 'cover', 400000)
        && (!('nota' in d) || d.nota == null || notaOk(d.nota))
        && texto(d, 'comentario', 300) && texto(d, 'catId', 40) && texto(d, 'titulo2', 200) && texto(d, 'alias', 1000)
        && (!('capa18' in d) || d.capa18 is bool);
    }
    function mangaValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'titulo2', 'alias', 'catId', 'chapter', 'status', 'link', 'cover', 'createdAt', 'updatedAt', 'lastReadAt', 'nota', 'comentario', 'capa18'])
        && camposManga(d);
    }
    function lixeiraValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'titulo2', 'alias', 'catId', 'chapter', 'status', 'link', 'cover', 'createdAt', 'updatedAt', 'lastReadAt', 'nota', 'comentario', 'excluidoEm', 'privado', 'capa18'])
        && camposManga(d) && d.excluidoEm is number && (!('privado' in d) || d.privado is bool);
    }
    // Nota que um visitante deixa: { nota, apelido (o dele, de verdade), em }
    function avaliacaoOk(v) {
      return v.keys().hasOnly(['nota', 'apelido', 'em'])
        && notaOk(v.nota) && v.em is number
        && exists(/databases/$(database)/documents/perfis/$(request.auth.uid))
        && v.apelido == get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.apelido;
    }

    // ---------- convidados ----------
    // Só o administrador libera e remove. A própria pessoa só pode gravar o seu "uid" (usado para ocultar/reativar o perfil).
    match /convidados/{email} {
      allow get: if admin() || (request.auth != null && request.auth.token.email.lower() == email);
      allow list, delete: if admin();
      allow create: if admin()
        && email.size() <= 200
        && request.resource.data.keys().hasOnly(['nome', 'adicionadoEm', 'uid'])
        && texto(request.resource.data, 'nome', 60);
      allow update: if (admin()
          && request.resource.data.keys().hasOnly(['nome', 'adicionadoEm', 'uid'])
          && texto(request.resource.data, 'nome', 60))
        || (request.auth != null && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid);
    }

    // ---------- apelidos: nunca repetem ----------
    // O documento tem o apelido em minúsculas como nome ("daniel"). Criar só funciona se ainda não existir.
    match /apelidos/{nome} {
      allow get: if request.auth != null;
      allow create: if acesso()
        && nome.matches('^[a-z0-9áàâãéêíóôõúüç]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ---------- perfis: apelido + foto + público/privado + vitrine (bio, cor, capa, favoritos) ----------
    // "oculto" = acesso removido pelo administrador: some da busca e ninguém vê a estante (nada é apagado).
    match /perfis/{uid} {
      allow get: if dono(uid) || (acesso() && resource.data.publico == true && resource.data.get('oculto', false) == false);
      allow list: if acesso() && resource.data.publico == true && resource.data.oculto == false;
      allow create, update: if dono(uid) && acesso()
        && request.resource.data.keys().hasOnly(['apelido', 'publico', 'foto', 'oculto', 'atualizadoEm', 'bio', 'cor', 'banner', 'bannerPos', 'favoritos', 'membroDesde'])
        && texto(request.resource.data, 'bio', 120) && texto(request.resource.data, 'cor', 12) && texto(request.resource.data, 'banner', 460000)
        && (!('bannerPos' in request.resource.data) || (request.resource.data.bannerPos is number && request.resource.data.bannerPos >= 0 && request.resource.data.bannerPos <= 100))
        && (!('favoritos' in request.resource.data) || (request.resource.data.favoritos is list && request.resource.data.favoritos.size() <= 3))
        && (!('membroDesde' in request.resource.data) || request.resource.data.membroDesde is number)
        && request.resource.data.apelido is string
        && request.resource.data.apelido.matches('^[A-Za-z0-9áàâãéêíóôõúüçÁÀÂÃÉÊÍÓÔÕÚÜÇ]{3,20}$')
        && request.resource.data.publico is bool
        && request.resource.data.get('oculto', false) == false
        && texto(request.resource.data, 'foto', 60000)
        && getAfter(/databases/$(database)/documents/apelidos/$(request.resource.data.apelido.lower())).data.uid == uid;
      // o administrador só pode mudar o "oculto"
      allow update: if admin() && !dono(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['oculto'])
        && request.resource.data.oculto is bool;
      allow delete: if dono(uid);
    }

    // ---------- estantes ----------
    // O dono lê e escreve. Os outros só leem, e só se o perfil do dono estiver público.
    match /users/{uid}/mangas/{mangaId} {
      allow read: if (dono(uid) && acesso()) || (acesso() && publico(uid));
      allow delete: if dono(uid);
      allow create, update: if dono(uid) && acesso() && mangaValido();
    }

    // ---------- mangás privados: só o dono lê e escreve (visitantes e ranking nunca veem) ----------
    match /users/{uid}/privados/{mangaId} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid) && acesso() && mangaValido();
    }

    // ---------- lixeira (só o dono vê) ----------
    match /users/{uid}/lixeira/{mangaId} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid) && acesso() && lixeiraValida();
    }

    // ---------- lista das notas que EU dei nos mangás dos outros (só eu vejo) ----------
    // Serve para, ao excluir a conta, remover só as minhas notas sem tocar no resto.
    match /users/{uid}/minhasNotas/{id} {
      allow read, delete: if dono(uid);
      allow create, update: if dono(uid) && acesso()
        && request.resource.data.keys().hasOnly(['dono', 'manga', 'em'])
        && request.resource.data.dono is string && request.resource.data.manga is string;
    }

    // ---------- notas dos visitantes (máximo 10 por mangá) ----------
    // Um documento por mangá: { notas: { idDoVisitante: { nota, apelido, em } } }
    match /users/{uid}/avaliacoes/{mangaId} {
      allow read: if (dono(uid) && acesso()) || (acesso() && publico(uid));
      allow delete: if dono(uid);
      allow create: if acesso() && !dono(uid) && publico(uid)
        && exists(/databases/$(database)/documents/users/$(uid)/mangas/$(mangaId))
        && request.resource.data.keys().hasOnly(['notas'])
        && request.resource.data.notas.keys().hasOnly([request.auth.uid])
        && avaliacaoOk(request.resource.data.notas[request.auth.uid]);
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['notas']) && (
        // o dono só pode remover notas
        (dono(uid) && request.resource.data.notas.keys().hasOnly(resource.data.notas.keys()))
        ||
        // o visitante só pode REMOVER a própria nota (sempre permitido, para excluir a conta com segurança)
        (!dono(uid)
          && request.resource.data.notas.diff(resource.data.notas).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.notas))
        ||
        // o visitante dá ou troca a própria nota: no máximo 10 pessoas por mangá
        (!dono(uid) && acesso() && publico(uid)
          && request.resource.data.notas.diff(resource.data.notas).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.notas.size() <= 10
          && avaliacaoOk(request.resource.data.notas[request.auth.uid]))
      );
    }

    // ---------- catálogo compartilhado (AniList / MyAnimeList, já em português) ----------
    match /catalogo/{id} {
      allow read: if acesso();
      allow create: if acesso()
        && id.matches('^(al|mal)[0-9]{1,10}$')
        && request.resource.data.keys().hasOnly(['titulo', 'titulo2', 'generos', 'sinopse', 'sinopseOrig', 'capa', 'tipo', 'alId', 'malId', 'atualizadoEm', 'nomeEN', 'nomePT', 'nomes', 'idade'])
        && nomesOk(request.resource.data)
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 200
        && texto(request.resource.data, 'titulo2', 200) && texto(request.resource.data, 'sinopse', 4000)
        && texto(request.resource.data, 'sinopseOrig', 4000) && texto(request.resource.data, 'capa', 500)
        && request.resource.data.generos is list && request.resource.data.generos.size() <= 15;
      // só dá para completar a tradução de uma sinopse pendente, ou acrescentar os nomes da obra (uma vez)
      allow update: if acesso() && (
        (resource.data.sinopse == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sinopse', 'atualizadoEm'])
          && texto(request.resource.data, 'sinopse', 4000))
        || (!('nomes' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nomeEN', 'nomePT', 'nomes', 'idade', 'atualizadoEm'])
          && nomesOk(request.resource.data)));
    }

    // ---------- ranking (calculado todo dia 1 pelo GitHub; o app só lê) ----------
    match /ranking/{id} {
      allow read: if acesso();
      allow write: if false;
    }
    // capas do ranking guardadas à parte (as do MangaDex, que não podem ser exibidas direto do site)
    match /rkcapas/{id} {
      allow read: if acesso();
      allow write: if false;
    }

    // ---------- suporte: relatos de problemas ----------
    match /suporte/{id} {
      allow create: if acesso()
        && request.resource.data.keys().hasOnly(['texto', 'uid', 'email', 'apelido', 'versao', 'plataforma', 'criadoEm', 'resolvido'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000
        && request.resource.data.resolvido == false;
      allow read, update, delete: if admin();
    }

    // ---------- denúncias: uma por pessoa, por mangá ----------
    match /denuncias/{id} {
      allow create: if acesso()
        && request.resource.data.keys().hasOnly(['de', 'apelidoDe', 'alvo', 'alvoApelido', 'mangaId', 'titulo', 'motivo', 'texto', 'criadoEm', 'resolvido', 'tipo', 'sala', 'msgId', 'trecho'])
        && texto(request.resource.data, 'tipo', 10) && texto(request.resource.data, 'sala', 10) && texto(request.resource.data, 'msgId', 40) && texto(request.resource.data, 'trecho', 300)
        && request.resource.data.de == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.alvo + '_' + request.resource.data.mangaId
        && request.resource.data.motivo in ['capa', 'nome', 'comentario', 'spam', 'outro', 'ofensa', 'spoiler', 'improprio']
        && texto(request.resource.data, 'texto', 300) && texto(request.resource.data, 'titulo', 120)
        && texto(request.resource.data, 'apelidoDe', 30) && texto(request.resource.data, 'alvoApelido', 30)
        && request.resource.data.alvo is string && request.resource.data.alvo.size() <= 128
        && request.resource.data.mangaId is string && request.resource.data.mangaId.size() <= 100
        && request.resource.data.criadoEm is number && request.resource.data.resolvido == false;
      allow read, update, delete: if admin();
    }

    // ---------- fórum: 3 salas, mensagens apagadas depois de 7 dias pelo GitHub ----------
    function salaOk(s) { return s in ['geral', 'rec', 'spo']; }
    function fu(uid) { return /databases/$(database)/documents/forumUsers/$(uid); }
    match /forum/{sala}/msgs/{id} {
      allow read: if acesso() && salaOk(sala);
      allow create: if acesso() && salaOk(sala)
        && request.resource.data.keys().hasOnly(['uid', 'apelido', 'texto', 'spoiler', 'gif', 'resp', 'criadoEm', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.criadoEm is number
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 500
        && request.resource.data.spoiler is bool && (sala != 'spo' || request.resource.data.spoiler == true)
        && (!('gif' in request.resource.data) || (request.resource.data.gif is string && request.resource.data.gif.size() <= 600 && request.resource.data.gif.matches('^https://[^ ]+$')))
        && (request.resource.data.texto.size() > 0 || 'gif' in request.resource.data)
        && (!('resp' in request.resource.data) || (request.resource.data.resp is map && request.resource.data.resp.keys().hasOnly(['uid', 'apelido', 'trecho'])
            && texto(request.resource.data.resp, 'apelido', 30) && texto(request.resource.data.resp, 'trecho', 120) && texto(request.resource.data.resp, 'uid', 128)))
        && exists(/databases/$(database)/documents/perfis/$(request.auth.uid))
        && request.resource.data.apelido == get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.apelido
        // 1 mensagem a cada 5 segundos, e não pode estar silenciado
        && getAfter(fu(request.auth.uid)).data.ultima == request.time
        && (!exists(fu(request.auth.uid)) || (
              request.time > get(fu(request.auth.uid)).data.get('ultima', timestamp.value(0)) + duration.value(5, 's')
              && get(fu(request.auth.uid)).data.get('silenciadoAte', timestamp.value(0)) < request.time));
      // o administrador apaga (a mensagem vira "apagada pelo administrador")
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apagada', 'texto', 'gif'])
        && request.resource.data.apagada == true && request.resource.data.texto == '';
      allow delete: if admin();
    }
    // controle de envio (hora da última mensagem) e silêncio (só o administrador muda)
    match /forumUsers/{uid} {
      allow get: if dono(uid) || admin();
      allow create: if dono(uid) && acesso() && request.resource.data.keys().hasOnly(['ultima']) && request.resource.data.ultima == request.time;
      allow update: if dono(uid) && acesso() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultima']) && request.resource.data.ultima == request.time;
      allow create: if admin() && request.resource.data.keys().hasOnly(['silenciadoAte']) && request.resource.data.silenciadoAte is timestamp;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['silenciadoAte'])
        && (!('silenciadoAte' in request.resource.data) || request.resource.data.silenciadoAte is timestamp);
    }
    // avisos no sino (menções e respostas no fórum): quem escreve cria, o dono lê e apaga
    match /users/{uid}/avisos/{id} {
      allow read, delete: if dono(uid);
      allow create: if acesso() && !dono(uid)
        && request.resource.data.keys().hasOnly(['tipo', 'de', 'apelido', 'sala', 'trecho', 'em'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.tipo in ['mencao', 'resposta'] && salaOk(request.resource.data.sala)
        && texto(request.resource.data, 'apelido', 30) && texto(request.resource.data, 'trecho', 120) && request.resource.data.em is number;
    }
    // preferências do fórum (Não perturbe)
    match /users/{uid}/config/{id} {
      allow read: if dono(uid);
      allow write: if dono(uid) && (
        (id == 'forum' && request.resource.data.keys().hasOnly(['dnd']) && request.resource.data.dnd is bool)
        || (id == 'tutorial' && request.resource.data.keys().hasOnly(['visto']) && request.resource.data.visto is bool));
    }

    // Qualquer outra coisa: bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
