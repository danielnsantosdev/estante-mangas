rules_version = '2';
// Regras de segurança da Estante de Mangás.
// Elas rodam no servidor do Google: nem o app nem ninguém consegue passar por cima delas.
service cloud.firestore {
  match /databases/{database}/documents {

    // Você, o administrador (troque pelo seu e-mail, em minúsculas).
    function admin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'danielnsantos99@gmail.com';
    }

    // Está na lista de convidados? (coleção "convidados", um documento por e-mail, em minúsculas)
    function convidado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/convidados/$(request.auth.token.email.lower()));
    }

    // É o dono desta estante?
    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // O mangá enviado tem só os campos esperados, nos tamanhos esperados?
    function mangaValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'chapter', 'status', 'link', 'cover', 'createdAt', 'updatedAt', 'lastReadAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.chapter is number && d.chapter >= 0 && d.chapter < 100000
        && d.status in ['lendo', 'fila', 'acumulando', 'pausado', 'concluido']
        && (!('link' in d) || (d.link is string && d.link.size() <= 2000))
        && (!('cover' in d) || (d.cover is string && d.cover.size() <= 400000));
    }

    // Lista de convidados: cada pessoa só confere o próprio e-mail.
    // Só o administrador vê a lista inteira, adiciona e remove (pela aba Administrador do app).
    match /convidados/{email} {
      allow get: if admin() || (request.auth != null && request.auth.token.email.lower() == email);
      allow list, delete: if admin();
      allow create, update: if admin()
        && email.size() <= 200
        && request.resource.data.keys().hasOnly(['nome', 'adicionadoEm'])
        && (!('nome' in request.resource.data) || (request.resource.data.nome is string && request.resource.data.nome.size() <= 60));
    }

    // Estantes: só o dono, e só se estiver liberado (ou for o administrador).
    match /users/{uid}/mangas/{mangaId} {
      allow read, delete: if dono(uid) && (convidado() || admin());
      allow create, update: if dono(uid) && (convidado() || admin()) && mangaValido();
    }

    // Qualquer outra coisa: bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
